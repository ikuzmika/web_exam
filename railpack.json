{
    "$schema": "https://schema.railpack.com",
    "provider": "php",
    "packages": {
        "php": "8.4",
        "node": "22"
    },
    "steps": {
        "build": {
            "commands": [
                "mkdir -p storage/framework/views storage/framework/cache storage/framework/sessions bootstrap/cache",
                "composer install --no-dev --optimize-autoloader",
                "php artisan view:cache"
            ]
        }
    },
    "buildAptPackages": [
        "autoconf",
        "bison",
        "re2c",
        "pkg-config",
        "build-essential",
        "libcurl4-openssl-dev",
        "libgd-dev",
        "libssl-dev",
        "zlib1g-dev",
        "libreadline-dev",
        "libzip-dev",
        "libicu-dev",
        "libonig-dev",
        "libxml2-dev",
        "libsqlite3-dev",
        "libpq-dev",
        "libpng-dev",
        "libjpeg-dev",
        "libwebp-dev",
        "libfreetype6-dev",
        "gettext",
        "libgettextpo-dev",
        "unzip",
        "git",
        "curl"
    ],
    "deploy": {
        "startCommand": "php artisan storage:link || true && php artisan serve --host=0.0.0.0 --port=$PORT"
    }
}
